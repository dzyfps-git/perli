{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perli",
  "version": "0.2.0",
  "identifier": "com.dzyfps.perli",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Perli",
        "width": 1100,
        "height": 700,
        "transparent": true,
        "decorations": false,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost blob: data: asset: http://asset.localhost; img-src 'self' blob: data:; media-src blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4NEREQzRBOTg5MkM1RkMKUldUOHhaS1lTdHhOT0RKS0VKL1JFam1tTUVLOUdNdGxTdkV0bmJWK1E3NTVCemUvYWVtclR2c2oK",
      "endpoints": ["https://github.com/dzyfps-git/perli-releases/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/TimGM6mb.sf2": "TimGM6mb.sf2",
      "resources/TimGM6mb-LICENSE.txt": "TimGM6mb-LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
